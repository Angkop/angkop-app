# Append ?connection_limit=9&pool_timeout=20 when pointed at Supabase's session-mode
# pooler (pooler.supabase.com) — Prisma's default connection_limit (cpu cores * 2 + 1)
# can alone exceed the pooler's small client cap, causing "max clients reached" errors.
# Don't go much lower than this: several resolvers (jobMatches, savedJobs, skillGaps)
# each fan out 2-4 concurrent Prisma calls, and the web app fires several GraphQL
# queries at once per page (AppShell's `me`, the page's own query, the profile sheet's
# queries) — too low a limit trades "pool exhausted across all instances" for "this one
# instance's own queries queue up and time out" (Prisma's `pool_timeout` error) instead.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
REDIS_URL=
ML_SERVICE_URL=
WEB_URL=
PORT=

# Resume import — Gemini free-tier quota protection (all Redis-backed, see lib/resume-quota.ts)
RESUME_GLOBAL_DAILY_SOFT_CAP=800
RESUME_MAX_NEW_PARSES_PER_USER_PER_DAY=10
RESUME_MAX_NEW_PARSES_PER_USER_PER_WEEK=30
RESUME_USER_COOLDOWN_SECONDS=30
RESUME_BREAKER_PAUSE_MINUTES=5
RESUME_CACHE_TTL_DAYS=90
