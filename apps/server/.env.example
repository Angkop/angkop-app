# Use Supabase's Transaction-mode pooler — host:6543 (not :5432, which is Session mode
# and caps at 15 total clients shared across every instance that connects, local dev
# and production alike). Append ?pgbouncer=true (required — disables prepared statements,
# which transaction-mode pooling can't support across requests) and a connection_limit
# (9 has worked well; several resolvers fan out 2-4 concurrent Prisma calls per request,
# and the web app fires multiple GraphQL queries at once per page, so don't go too low
# or this instance's own queries queue up and hit Prisma's pool_timeout instead).
# Example: postgresql://...@host.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=9&pool_timeout=20
DATABASE_URL=
# Direct (non-pooled) connection — Supabase dashboard > Project Settings > Database >
# "Direct connection". Only used by `prisma migrate`/`db push`, which can't run through
# transaction-mode pooling. Never used by the running app itself.
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
REDIS_URL=
ML_SERVICE_URL=
WEB_URL=
PORT=

# Resume import — Gemini free-tier quota protection (all Redis-backed, see lib/resume-quota.ts)
RESUME_GLOBAL_DAILY_SOFT_CAP=800
RESUME_MAX_NEW_PARSES_PER_USER_PER_DAY=10
RESUME_MAX_NEW_PARSES_PER_USER_PER_WEEK=30
RESUME_USER_COOLDOWN_SECONDS=30
RESUME_BREAKER_PAUSE_MINUTES=5
RESUME_CACHE_TTL_DAYS=90
