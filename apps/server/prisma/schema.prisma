generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CareerLevel {
  STUDENT
  ENTRY_LEVEL
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
  MANAGER
}

enum WorkSetup {
  REMOTE
  HYBRID
  ONSITE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  PROFESSIONAL
  NATIVE
}

model User {
  id            String           @id
  email         String           @unique
  name          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deleted       Boolean          @default(false)
  profile       UserProfile?
  userSkills    UserSkill[]
  interactions  Interaction[]
  skillGaps     SkillGapRecord[]
  savedJobs     SavedJob[]
  savedCourses  SavedCourse[]
  matchInsights MatchInsight[]
}

model Skill {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  category   String?
  deleted    Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  userSkills UserSkill[]
}

model UserSkill {
  id        Int         @id @default(autoincrement())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  skillId   Int
  skill     Skill       @relation(fields: [skillId], references: [id])
  level     SkillLevel?
  years     Float?
  deleted   Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, skillId])
}

model UserProfile {
  id             Int              @id @default(autoincrement())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id])
  headline       String?
  about          String?
  skillsText     String
  embedding      Float[]
  careerLevel    CareerLevel?
  location       String?
  resumeFileName String?
  education      Education[]
  experience     WorkExperience[]
  certifications Certification[]
  projects       Project[]
  languages      Language[]
  preferences    UserPreference?
  deleted        Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Education {
  id            Int         @id @default(autoincrement())
  userProfileId Int
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])
  school        String
  degree        String?
  fieldOfStudy  String?
  startYear     Int?
  endYear       Int?
  description   String?
  deleted       Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model WorkExperience {
  id             Int             @id @default(autoincrement())
  userProfileId  Int
  userProfile    UserProfile     @relation(fields: [userProfileId], references: [id])
  title          String
  company        String
  location       String?
  employmentType EmploymentType?
  description    String?
  startDate      DateTime
  endDate        DateTime?
  current        Boolean         @default(false)
  deleted        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Certification {
  id             Int         @id @default(autoincrement())
  userProfileId  Int
  userProfile    UserProfile @relation(fields: [userProfileId], references: [id])
  name           String
  issuer         String
  issueDate      DateTime?
  expirationDate DateTime?
  credentialId   String?
  credentialUrl  String?
  deleted        Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Project {
  id            Int         @id @default(autoincrement())
  userProfileId Int
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])
  name          String
  description   String
  technologies  String[]
  url           String?
  startDate     DateTime?
  endDate       DateTime?
  deleted       Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Language {
  id            Int                  @id @default(autoincrement())
  userProfileId Int
  userProfile   UserProfile          @relation(fields: [userProfileId], references: [id])
  language      String
  proficiency   LanguageProficiency?
  deleted       Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model UserPreference {
  id                  Int              @id @default(autoincrement())
  userProfileId       Int              @unique
  userProfile         UserProfile      @relation(fields: [userProfileId], references: [id])
  desiredRoles        String[]
  preferredLocations  String[]
  preferredJobTypes   EmploymentType[]
  preferredIndustries String[]
  workSetup           WorkSetup?
  minimumSalary       Float?
  maximumSalary       Float?
  willingToRelocate   Boolean          @default(false)
  willingToRemote     Boolean          @default(true)
  deleted             Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model Job {
  id             String           @id
  platformJobId  String
  platform       String
  title          String
  company        String
  description    String
  requiredSkills String[]
  url            String
  embedding      Float[]
  sourceName     String?
  sourceUrl      String?
  location       String?
  salaryMin      Float?
  salaryMax      Float?
  workSetup      WorkSetup?
  employmentType EmploymentType?
  detectedLanguage    String?
  descriptionSections JobDescriptionSection[]
  interactions   Interaction[]
  skillGaps      SkillGapRecord[]
  savedBy        SavedJob[]
  matchInsights  MatchInsight[]
  deleted        Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([platform, platformJobId])
}

model JobDescriptionSection {
  id        Int      @id @default(autoincrement())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  // Position within the listing — doubles as the natural key ingestion upserts against
  // (see ingest-jobs.ts), so re-running ingestion updates existing sections in place
  // instead of duplicating them. null heading = the lead-in text before any heading.
  order     Int
  heading   String?
  items     String[]
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, order])
}

model Interaction {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  eventType String
  weight    Float
  platform  String
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SkillGapRecord {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id])
  skill      String
  confidence Float
  courses    Json
  deleted    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// "Why this is a match" dialog content — the algorithm's score breakdown plus Gemini's
// natural-language explanation, generated once per (userId, jobId) and reused on every
// later dialog open instead of re-paying for a Gemini call each time. Soft-deleted (not
// recomputed in place) whenever the user's skillsText changes, since the explanation and
// matchingSkills/missingSkills are grounded in that snapshot.
model MatchInsight {
  id                 Int      @id @default(autoincrement())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  jobId              String
  job                Job      @relation(fields: [jobId], references: [id])
  semanticScore      Float
  collaborativeScore Float
  hybridScore        Float
  // The concrete numbers behind each score, shown alongside the plain-language reasons.
  requiredSkillsCount Int
  interactionCount    Int
  collaborativeWeight Float
  // Plain-language, job-specific justifications for the two scores above — what a job
  // seeker actually wants ("you already know React"), not the algorithm's own vocabulary.
  skillsReason       String
  activityReason     String
  matchingSkills     String[]
  missingSkills      String[]
  explanation        String
  deleted            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, jobId])
}

enum ApplicationStatus {
  PENDING
  APPLIED
  AWAITING_INTERVIEW
  ONGOING_INTERVIEW
  INTERVIEWED
  SUCCESSFUL
  UNSUCCESSFUL
}

model SavedJob {
  id            Int               @id @default(autoincrement())
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  jobId         String
  job           Job               @relation(fields: [jobId], references: [id])
  status        ApplicationStatus @default(PENDING)
  tags          String[]          @default([])
  interviewDate DateTime?
  deleted       Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, jobId])
}

model SavedCourse {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  provider  String
  url       String
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, url])
}
